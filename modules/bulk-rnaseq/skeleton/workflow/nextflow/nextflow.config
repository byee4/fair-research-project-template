// Scientific params here are governed by policy/authority.yaml.
plugins {
    id 'nf-schema@2.7.3'
    id 'nf-prov@1.4.0'
}

params {
    data_root  = "${projectDir}/../.."
    input      = "${projectDir}/../../config/samples.tsv"
    outdir     = "${projectDir}/../../results"
    star_index = "${projectDir}/../../data/external/star_index"
    gtf        = "${projectDir}/../../data/external/gencode.v47.annotation.gtf"
    min_mapq   = 10
}

process {
    container = "${projectDir}/../../containers/analysis.sif"
    withLabel: 'process_single' { cpus = 1;  memory = '2 GB';  time = '1h' }
    withLabel: 'process_low'    { cpus = 2;  memory = '8 GB';  time = '2h' }
    withLabel: 'process_medium' { cpus = 4;  memory = '16 GB'; time = '4h' }
    withLabel: 'process_high'   { cpus = 8;  memory = '40 GB'; time = '8h' }
}

// FAIR provenance: Workflow Run RO-Crate + BioCompute Object for every run.
prov {
    enabled = true
    formats {
        wrroc {
            file = "${params.outdir}/ro-crate-metadata.json"
            overwrite = true
            agent {
                name  = "<Your Name>"
                orcid = "https://orcid.org/0000-0000-0000-0000"
            }
            license = "https://spdx.org/licenses/CC-BY-4.0"
        }
        bco {
            file      = "${params.outdir}/bco.json"
            overwrite = true
        }
    }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.tsv";     overwrite = true }

profiles {
    test {
        params.input = "${projectDir}/../../tests/fixtures/mini/samples.tsv"
        params.outdir = "${projectDir}/../../results_test"
        process.cpus = 1
    }
    tscc {
        apptainer.enabled  = true
        apptainer.runOptions = "--bind /tscc/lustre/ddn/scratch/\$USER --bind /tscc/projects"
        process.executor   = 'slurm'
        process.queue      = 'condo'                        // or hotel
        process.clusterOptions = '--qos=condo --account=<your_allocation>'
        executor { queueSize = 100; submitRateLimit = '10/1min' }
        workDir = "/tscc/lustre/ddn/scratch/${System.getenv('USER')}/nf-work"   // purged after 90 days
    }
    awsbatch {
        docker.enabled  = true
        process.container = '<account>.dkr.ecr.<region>.amazonaws.com/<project>-analysis@sha256:<digest>'
        process.executor = 'awsbatch'
        process.queue    = '<batch-queue>'
        aws.region       = 'us-west-2'
        aws.batch.cliPath = '/home/ec2-user/miniconda/bin/aws'
        workDir          = 's3://<lab-bucket>/<project>/nf-work'
    }
}
